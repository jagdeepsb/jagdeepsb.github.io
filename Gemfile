    source 'https://rubygems.org'

# Ruby 3.3 removed these from its default core library. 
# Explicitly adding them fixes the loading warnings and crashes.
gem 'webrick'
gem 'csv'
gem 'base64'
gem 'bigdecimal'

group :jekyll_plugins do
    # Upgrading to 232+ pulls in the fixes required for Ruby 3.3
    gem 'github-pages', '~> 232'
    gem 'jekyll-paginate'
    gem 'jekyll-scholar'
    gem 'jemoji'
    gem 'unicode'
end